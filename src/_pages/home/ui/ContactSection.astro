---
import { contact, ownerPlaceholder, profile } from "@entities/profile";
import HomeSection from "./HomeSection.astro";

const { form } = contact;
const email = profile.email;
---

<HomeSection id="contact" index={5} labelledBy="contact-title" align="end">
  <div class="contact">
    <p class="eyebrow">{contact.eyebrow}</p>
    <h2 id="contact-title" class="display section-title">
      {contact.title} <em>{contact.titleAccent}</em>
    </h2>
    <p class="contact__sub">{contact.copy}</p>

    <form
      class="contact__form"
      data-contact-form
      data-email={email ?? ""}
      novalidate
      inert
      aria-labelledby="contact-title"
    >
      <div class="field">
        <label for="contact-name">{form.name.label}</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required />
        <p
          class="field__error"
          id="contact-name-error"
          data-error-for="name"
          role="status"
          aria-live="polite"
          hidden
        >
          <span aria-hidden="true">!</span>
          {form.errors.name}
        </p>
      </div>

      {/* PF-69 rev 2: row 2 is Email | Phone (optional), two equal columns at >= 1280. */}
      <div class="contact__row">
        <div class="field">
          <label for="contact-email">{form.email.label}</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
          <p
            class="field__error"
            id="contact-email-error"
            data-error-for="email"
            role="status"
            aria-live="polite"
            hidden
          >
            <span aria-hidden="true">!</span>
            {form.errors.email}
          </p>
        </div>
        <div class="field">
          <label for="contact-phone">
            {form.phone.label} <span class="field__opt">{form.phone.optional}</span>
          </label>
          <input id="contact-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
      </div>

      <div class="field">
        <label for="contact-brief">{form.brief.label}</label>
        <textarea id="contact-brief" name="brief" rows="3" required></textarea>
        <p
          class="field__error"
          id="contact-brief-error"
          data-error-for="brief"
          role="status"
          aria-live="polite"
          hidden
        >
          <span aria-hidden="true">!</span>
          {form.errors.brief}
        </p>
      </div>

      <div class="contact__foot">
        <button class="button button--primary contact__submit" type="submit" disabled>
          {form.submit}
        </button>
        <p class="contact__note">{form.note}</p>
      </div>
      {email ? (
        <p class="contact__nojs-note" data-contact-nojs-note>
          {form.noJsNote}
        </p>
      ) : null}
      <p class="contact__status" role="status" aria-live="polite" data-form-status></p>
      <template data-form-messages>
        <span data-msg="success">{form.success}</span>
        <span data-msg="no-email">{form.noEmail}</span>
      </template>
    </form>

    <p class="contact__alt" data-email>
      {email ? (
        <>
          <a href={`mailto:${email}`} data-email-address>
            {email}
          </a>
          {/* Shown only when JS and the Clipboard API are available (no-JS: the link and the selectable address remain). */}
          <button
            type="button"
            class="contact__copy-email mono"
            aria-label={form.copyEmail}
            data-copy-email={email}
            data-copied={form.copied}
            data-copy-failed={form.copyFailed}
            hidden
          >
            {form.copyShort}
          </button>
          <span class="visually-hidden" role="status" aria-live="polite" data-copy-status />
        </>
      ) : (
        ownerPlaceholder("email")
      )}
    </p>
  </div>
</HomeSection>

<script>
  import { initContactForm } from "../lib/contact-form";
  import { initCopyEmail } from "../lib/copy-email";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) initContactForm(form);
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  if (copyButton) initCopyEmail(copyButton);
</script>

<style>
  /* Option B (design/contact-redesign.md): one calm column, no card. PF-69 (design/contact-v3):
     soft filled fields (faint warm fill, 6px top radius, bottom line kept), labels in --text. */
  .contact {
    width: min(32rem, 100%);
    padding-bottom: 2rem;
  }

  .contact .section-title {
    margin-top: var(--space-3);
  }

  .contact__sub {
    margin-top: var(--space-5);
    color: var(--muted);
    font-size: 1.125rem;
  }

  .contact__form {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .field {
    display: grid;
    align-content: start; /* errors never stretch inputs */
    gap: var(--space-2);
  }

  .field label {
    color: var(--text);
    font: 500 0.8125rem/1.3 var(--font-sans);
  }

  .field__opt {
    color: var(--muted);
    font-weight: 400;
  }

  /* PF-69 rev 2: every input is exactly 44 px. */
  .field input {
    height: 2.75rem;
    min-height: 2.75rem;
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: var(--tap-min);
    padding: 0.625rem 0.75rem;
    border: 0;
    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
    box-shadow: inset 0 -1px 0 var(--line-strong);
    background: rgb(255 241 228 / 0.04);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    transition:
      box-shadow var(--t-micro) var(--ease-out),
      background-color var(--t-micro) var(--ease-out);
  }

  .field textarea {
    min-height: 6rem;
    resize: none;
  }

  .field input:hover,
  .field textarea:hover {
    background: rgb(255 241 228 / 0.06);
    box-shadow: inset 0 -1px 0 var(--muted);
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    background: rgb(255 194 75 / 0.07);
    box-shadow: inset 0 -2px 0 var(--accent-2);
  }

  .field [aria-invalid="true"],
  .field [aria-invalid="true"]:hover {
    box-shadow: inset 0 -2px 0 var(--error);
  }

  .field__error {
    display: flex;
    gap: 0.4rem;
    align-items: flex-start; /* icon sits on the first line of a two-line error */
    line-height: 1.3;
    color: var(--error);
    font-size: 0.8125rem;
  }

  .field__error span {
    flex: none;
    margin-top: 0.05rem;
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--error);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.6875rem;
  }

  .contact__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .contact__note,
  .contact__nojs-note,
  .contact__status {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .contact__status {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-xs);
    background: rgb(255 194 75 / 0.08);
    box-shadow: inset 2px 0 0 var(--accent-2);
    color: var(--text);
  }

  .contact__status::before {
    content: "● ";
    color: var(--accent-2);
  }

  /* html.js is set in the head before first paint, so with JS this note is never
     in the layout and does not shift the form. Without JS it stays visible. */
  :global(html.js) .contact__nojs-note {
    display: none;
  }

  .contact__status:empty {
    display: none;
  }

  .contact__alt {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    align-items: center;
    margin-top: var(--space-5);
    font-size: 0.875rem;
  }

  .contact__alt a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--text);
    text-decoration-color: var(--accent-2);
    transition: color var(--t-micro) var(--ease-out);
  }

  .contact__alt a:hover {
    color: var(--accent-2);
  }

  .contact__copy-email {
    min-height: var(--tap-min);
    padding: 0 0.5rem;
    border: 0;
    background: transparent;
    color: var(--accent-2);
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .field input,
    .field textarea,
    .contact__alt a {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .contact {
      width: 100%;
    }

    .contact__foot {
      flex-direction: column;
      align-items: flex-start;
    }

    .contact__submit {
      width: 100%;
      min-height: 48px;
    }
  }

  /* PF-69 rev 3: the two-column grid (Name / Email | Phone / Message / Send) starts at 1200 px,
     pinned or not; below 1200 (incl. 1024 and phones) the form is one stacked column. */
  @media (max-width: 1199px) {
    .contact__row {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Pinned (full tier): the column sits on the left, clear of the lit print
     (design.md kf-06). ---------- */
  /* B spec says min(32rem, 36vw); the live tray's left edge sits at ~39 % of the width (the mockup's
     print is further right), so the column is a little narrower to stay clear of it at 1280–1440. */
  :global(html[data-pin="on"]) .contact {
    width: min(30rem, 33vw);
    padding-bottom: 0;
  }

  :global(html[data-pin="on"]) .contact__form {
    gap: var(--space-4);
  }

  :global(html[data-pin="on"]) .contact .field textarea {
    min-height: 5rem;
    height: 5rem;
  }

  /* PF-69: floor 27rem → 26.75rem (428 px) keeps ≥ ~11 px off the tray rim at 1280 and still fits
     Send brief + 16 px + the reply note on one row (427.3 px). */
  /* PF-60: at 1280, 33vw is ~422 px — about 5 px short of "Send brief" + gap + the reply note
     on one row (Option B). Floor the pinned column from 1280 up so the note stays beside the
     button, without widening it at 1440 (33vw already fits; tray clearance is tight) or below
     1280 (wrapping is allowed, and a floor would eat into the tray near the 1200 pin start). */
  @media (min-width: 1280px) {
    :global(html[data-pin="on"]) .contact {
      width: min(30rem, max(26.75rem, 33vw));
    }
  }

  :global(html[data-pin="on"]) .contact .section-title {
    font-size: min(6rem, 6vw, 9.5vh);
  }

  /* Desktop pointer: the Copy text button is 2rem tall (B spec); phones keep 44 px. */
  @media (min-width: 768px) {
    .contact__copy-email,
    .contact__alt a {
      min-height: 2rem;
    }
  }

  /* Short pinned viewports (760–899 px tall): tighten the stack so the address line ends
     above the sticky footer (QA B-1; checked at 1200×760 and 1280×800). */
  @media (max-height: 899px) {
    :global(html[data-pin="on"]) .contact__form {
      gap: var(--space-4);
      margin-top: var(--space-6);
    }

    :global(html[data-pin="on"]) .contact__alt {
      margin-top: var(--space-4);
    }

    :global(html[data-pin="on"]) .contact__sub {
      margin-top: var(--space-3);
      font-size: 1rem;
    }

    :global(html[data-pin="on"]) .contact .field textarea {
      min-height: 3.5rem;
      height: 3.5rem;
    }
  }

  /* PF-69 rev 3: short pinned viewports from 1200 px (1200×760, 1280×800): message box 56 px
     and a tighter error line so the error state fits above the footer. If it still doesn't,
     contact-form.ts unpins the layer (safety net, below). */
  @media (min-width: 1200px) and (max-height: 820px) {
    :global(html[data-pin="on"]) .contact .field textarea {
      min-height: 3.5rem;
      height: 3.5rem;
    }

    :global(html[data-pin="on"]) .contact .field__error {
      line-height: 1.15;
    }
  }

  /* PF-69 rev 3 safety net: while .contact[data-state] (error / success) would run under the
     footer, contact-form.ts unpins the layer from its slot: it moves up by --unpin-lift (the
     overflow), so the form ends 12 px above the footer whatever the scroll position. */
  :global(html[data-pin="on"] .home-section__body[data-unpinned]) {
    inset: calc(var(--unpin-lift, 0px) * -1) 0 var(--unpin-lift, 0px);
  }

  /* PF-64 (in PF-69): 768–1279 with the tray unpinned the column narrows to 30.5vw so it clears
     the lit tray (tray left edge ≈ 375 px at 1024). Pinned 1200–1279 keeps the 33vw column. */
  @media (min-width: 768px) and (max-width: 1279px) {
    :global(html:not([data-pin="on"])) .contact {
      width: min(30rem, 30.5vw);
    }
  }
</style>
