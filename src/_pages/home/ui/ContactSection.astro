---
import { contact, ownerPlaceholder, profile } from "@entities/profile";
import HomeSection from "./HomeSection.astro";

const { form } = contact;
const email = profile.email;
---

<HomeSection id="contact" index={5} labelledBy="contact-title" align="end">
  <div class="contact">
    <div class="contact__intro">
      <p class="eyebrow">{contact.eyebrow}</p>
      <h2 id="contact-title" class="display section-title">
        {contact.title} <em>{contact.titleAccent}</em>
      </h2>
      <p class="contact__copy">{contact.copy}</p>
      <dl class="contact__links mono">
        <div>
          <dt>Email</dt>
          <dd data-email>
            {email ? (
              <>
                <a href={`mailto:${email}`} data-email-address>
                  {email}
                </a>
                {/* Shown only when JS and the Clipboard API are available (no-JS: the link and the selectable address remain). */}
                <button
                  type="button"
                  class="contact__copy-email"
                  data-copy-email={email}
                  data-copied={form.copied}
                  data-copy-failed={form.copyFailed}
                  hidden
                >
                  {form.copyEmail}
                </button>
                <span class="visually-hidden" role="status" aria-live="polite" data-copy-status />
              </>
            ) : (
              ownerPlaceholder("email")
            )}
          </dd>
        </div>
        {profile.socials.map((social) => (
          <div>
            <dt>{social.label}</dt>
            <dd>
              <a href={social.href} rel="me noopener noreferrer" target="_blank">
                {social.handle}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </dd>
          </div>
        ))}
        <div>
          <dt>Time</dt>
          <dd>{profile.timezone}</dd>
        </div>
      </dl>
    </div>

    <form
      class="card contact__form"
      data-contact-form
      data-email={email ?? ""}
      action={email ? `mailto:${email}` : undefined}
      method="post"
      enctype="text/plain"
      novalidate
      aria-labelledby="contact-title"
    >
      <fieldset class="contact__modes">
        <legend class="visually-hidden">I'm writing about</legend>
        {form.modes.map((mode, i) => (
          <label>
            <input type="radio" name="mode" value={mode} checked={i === 0} data-mode={i} />
            <span>{mode}</span>
          </label>
        ))}
      </fieldset>

      <div class="contact__row">
        <div class="field">
          <label for="contact-name">{form.name.label}</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder={form.name.placeholder}
            required
          />
          <p
            class="field__error"
            id="contact-name-error"
            data-error-for="name"
            role="status"
            aria-live="polite"
            hidden
          >
            <span aria-hidden="true">!</span>
            {form.errors.name}
          </p>
        </div>
        <div class="field">
          <label for="contact-email">{form.email.label}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder={form.email.placeholder}
            required
          />
          <p
            class="field__error"
            id="contact-email-error"
            data-error-for="email"
            role="status"
            aria-live="polite"
            hidden
          >
            <span aria-hidden="true">!</span>
            {form.errors.email}
          </p>
        </div>
      </div>

      <div class="field" data-project-type>
        <label for="contact-type">{form.projectType.label}</label>
        <select id="contact-type" name="project-type">
          {form.projectType.options.map((option) => (
            <option>{option}</option>
          ))}
        </select>
      </div>

      <div class="field">
        <label for="contact-brief">{form.brief.label}</label>
        <textarea
          id="contact-brief"
          name="brief"
          rows="3"
          placeholder={form.brief.placeholder}
          required
        ></textarea>
        <p
          class="field__error"
          id="contact-brief-error"
          data-error-for="brief"
          role="status"
          aria-live="polite"
          hidden
        >
          <span aria-hidden="true">!</span>
          {form.errors.brief}
        </p>
      </div>

      <button class="button button--primary contact__submit" type="submit">
        {form.submit}
      </button>
      <p class="contact__note">{form.note}</p>
      <p class="contact__status" role="status" aria-live="polite" data-form-status></p>
      <template data-form-messages>
        <span data-msg="success">{form.success}</span>
        <span data-msg="no-email">{form.noEmail}</span>
      </template>
    </form>
  </div>
</HomeSection>

<script>
  import { initContactForm } from "../lib/contact-form";
  import { initCopyEmail } from "../lib/copy-email";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) initContactForm(form);
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  if (copyButton) initCopyEmail(copyButton);
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding-bottom: 2rem;
  }

  .contact__intro {
    display: grid;
    gap: 1.25rem;
  }

  .contact__copy {
    color: var(--muted);
    max-width: 32rem;
  }

  .contact__links {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.875rem;
  }

  .contact__links div {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .contact__links dt {
    min-width: 5.5rem;
    color: var(--accent-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact__links dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
    margin: 0;
  }

  .contact__copy-email {
    min-height: 2.75rem;
    padding: 0 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .contact__copy-email:hover {
    border-color: var(--accent-2);
  }

  .contact__copy-email[data-state="copied"] {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  .contact__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
  }

  .contact__form {
    display: grid;
    gap: 0.9rem;
  }

  .contact__modes {
    display: flex;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .contact__modes label {
    flex: 1;
  }

  .contact__modes input {
    position: absolute;
    opacity: 0;
  }

  .contact__modes span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .contact__modes input:checked + span {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  .contact__modes input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label {
    font: 500 0.6875rem/1.2 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: rgb(14 10 8 / 0.8);
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
  }

  .field ::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .field [aria-invalid="true"] {
    border-color: var(--error);
  }

  .field__error {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--error);
    font-size: 0.8125rem;
  }

  .field__error span {
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--error);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.6875rem;
  }

  .contact__submit {
    width: 100%;
  }

  .contact__note,
  .contact__status {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .contact__status:empty {
    display: none;
  }

  @media (max-width: 767px) {
    .contact,
    .contact__row {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Pinned (full tier): one compact column on the left, clear of the lit print
     (design.md kf-06). ---------- */
  :global(html[data-pin="on"]) .contact {
    grid-template-columns: minmax(0, 36rem);
    gap: 0.7rem;
    align-items: start;
    padding-bottom: 0;
  }

  :global(html[data-pin="on"]) .contact__intro {
    gap: 0.7rem;
  }

  :global(html[data-pin="on"]) .contact__intro .section-title {
    font-size: min(6.5rem, 6.5vw, 10.4vh);
  }

  /* Contact links go under the form, as in the mockup. */
  :global(html[data-pin="on"]) .contact__intro {
    display: contents;
  }

  :global(html[data-pin="on"]) .contact__links {
    order: 2;
  }

  :global(html[data-pin="on"]) .contact__form {
    order: 1;
  }

  :global(html[data-pin="on"]) .contact__copy {
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  :global(html[data-pin="on"]) .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    font-size: 0.75rem;
  }

  :global(html[data-pin="on"]) .contact__links div {
    gap: 0.5rem;
  }

  :global(html[data-pin="on"]) .contact__links dt {
    min-width: 0;
  }

  :global(html[data-pin="on"]) .contact__links a {
    min-height: 2rem;
  }

  :global(html[data-pin="on"]) .contact {
    width: min(34rem, 40vw);
  }

  :global(html[data-pin="on"]) .contact__form {
    gap: 0.5rem;
    padding: 0.9rem 1.1rem;
  }

  :global(html[data-pin="on"]) .contact__form .field {
    gap: 0.25rem;
  }

  :global(html[data-pin="on"]) .contact__form textarea {
    min-height: 2.75rem;
    height: 2.75rem;
  }

  :global(html[data-pin="on"]) .contact__note {
    font-size: 0.8125rem;
  }

  /* Short pinned viewports (760–899 px tall): tighten the stack so the links under the form end
     above the sticky footer and stay clickable (QA B-1; checked at 1200×760 and 1280×800). */
  @media (max-height: 899px) {
    :global(html[data-pin="on"]) .contact {
      gap: 0.5rem;
    }

    :global(html[data-pin="on"]) .contact__intro .section-title {
      font-size: min(6.5rem, 6.5vw, 6.5vh);
    }

    :global(html[data-pin="on"]) .contact__links a {
      min-height: 1.75rem;
    }

    :global(html[data-pin="on"]) .contact__copy {
      font-size: 0.875rem;
      line-height: 1.45;
    }

    :global(html[data-pin="on"]) .contact__form {
      gap: 0.4rem;
      padding: 0.75rem 1rem;
    }
  }
</style>
