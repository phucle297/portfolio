---
/**
 * One of the six page sections. On desktop each section's height is a fixed share of the
 * scrollable height, so the DOM boundaries land on the timeline's points (0 / .12 / .30 / .52 /
 * .68 / .84, see `SECTIONS` in @shared/lib/timeline). Heights come from CSS only.
 */
import SectionStill from "./SectionStill.astro";

interface Props {
  id: string;
  index: number;
  labelledBy: string;
  align?: "start" | "center" | "end";
}

const { id, index, labelledBy, align = "center" } = Astro.props;
---

<section
  id={id}
  class:list={["home-section", `home-section--${id}`, `home-section--align-${align}`]}
  aria-labelledby={labelledBy}
  data-section={id}
>
  <SectionStill index={index} eager={index === 0} />
  <div class="home-section__body container" data-copy-body>
    <slot />
  </div>
</section>

<style>
  .home-section {
    position: relative;
    display: flex;
    flex-direction: column;
    scroll-margin-top: 0;
  }

  .home-section__body {
    position: relative;
    z-index: 2;
    padding-block: calc(var(--header-h) + 2rem) 4rem;
  }

  @media (min-width: 768px) {
    .home-section {
      --scroll: 1000vh;
    }

    .home-section--hello {
      min-height: calc(var(--scroll) * 0.12);
    }

    .home-section--journey {
      min-height: calc(var(--scroll) * 0.18);
    }

    .home-section--work {
      min-height: calc(var(--scroll) * 0.22);
    }

    .home-section--services,
    .home-section--process {
      min-height: calc(var(--scroll) * 0.16);
    }

    /* The last section also spans the final viewport, minus the footer. */
    .home-section--contact {
      min-height: calc(var(--scroll) * 0.16 + 100vh - var(--footer-h));
    }

    .home-section--align-start {
      justify-content: flex-start;
    }

    .home-section--align-center {
      justify-content: center;
    }

    .home-section--align-end {
      justify-content: flex-end;
    }
  }

  /* ---------- Pinned copy (full tier on large viewports, see lib/copy-layer.ts) ----------
     Each section's copy is pinned over the scene and scrubbed by the shared timeline: the
     copy layer writes --copy-o / --copy-y. Copy is never display:none / visibility:hidden, and
     focus inside it forces it visible. */
  :global(html[data-pin="on"]) .home-section__body {
    position: fixed;
    inset: 0;
    z-index: 2;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    width: auto;
    max-width: none;
    margin: 0;
    padding: calc(var(--header-h) + 1.5rem) var(--gutter) 4.5rem;
    opacity: var(--copy-o, 0);
    transform: translate3d(0, var(--copy-y, 0), 0);
    pointer-events: none;
  }

  /* Only the copy itself takes the pointer; empty space falls through to the page, so a click
     there leaves keyboard scrolling (arrows) on the document instead of a fixed layer (M2-AC9). */
  :global(html[data-pin="on"])
    .home-section__body[data-copy-active]
    :where(a, button, input, select, textarea, label, summary, p, h1, h2, h3, li, dl, .card) {
    pointer-events: auto;
  }

  :global(html[data-pin="on"]) .home-section__body:focus-within {
    z-index: 3;
    opacity: 1;
    transform: none;
  }

  /* Each section's own scrim, fading with its copy (design.md §5 / the round-7 prototype). */
  :global(html[data-pin="on"]) .home-section__body::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--pin-scrim, none);
    pointer-events: none;
  }

  :global(html[data-pin="on"]) .home-section {
    --scrim-a: rgb(14 10 8 / 0.95);
    --scrim-b: rgb(14 10 8 / 0.82);
  }

  :global(html[data-pin="on"]) .home-section--hello .home-section__body {
    --pin-scrim: radial-gradient(
      31.25vw 43vh at 23.25% 50%,
      rgb(14 10 8 / 0.93),
      rgb(14 10 8 / 0.75) 60%,
      rgb(14 10 8 / 0)
    );
    justify-content: center;
  }

  :global(html[data-pin="on"]) .home-section--journey .home-section__body {
    --pin-scrim: radial-gradient(
      37.5vw 48vh at 18.75% 76%,
      var(--scrim-a),
      var(--scrim-b) 60%,
      rgb(14 10 8 / 0)
    );
    justify-content: flex-end;
  }

  :global(html[data-pin="on"]) .home-section--work .home-section__body {
    --pin-scrim: radial-gradient(
      48vw 26vh at 50% calc(100% - 15vh),
      var(--scrim-a),
      var(--scrim-b) 60%,
      rgb(14 10 8 / 0)
    );
  }

  :global(html[data-pin="on"]) .home-section--services .home-section__body {
    --pin-scrim: radial-gradient(
      34.4vw 28vh at 50% 14%,
      var(--scrim-a),
      var(--scrim-b) 60%,
      rgb(14 10 8 / 0)
    );
  }

  :global(html[data-pin="on"]) .home-section--process .home-section__body {
    --pin-scrim: radial-gradient(
      44vw 34vh at 50% 26%,
      var(--scrim-a),
      var(--scrim-b) 60%,
      rgb(14 10 8 / 0)
    );
  }

  :global(html[data-pin="on"]) .home-section--contact .home-section__body {
    --pin-scrim: radial-gradient(
      32.5vw 50vh at 13.75% 56%,
      var(--scrim-a),
      var(--scrim-b) 60%,
      rgb(14 10 8 / 0)
    );
    padding-bottom: calc(var(--footer-h) + 1rem);
  }

  /* Anchor links land on the section's key state, not on the copy-free boundary. */
  :global(html[data-pin="on"]) .home-section--journey {
    scroll-margin-top: calc(var(--scroll) * -0.09);
  }

  :global(html[data-pin="on"]) .home-section--work {
    scroll-margin-top: calc(var(--scroll) * -0.11);
  }

  :global(html[data-pin="on"]) .home-section--services,
  :global(html[data-pin="on"]) .home-section--process {
    scroll-margin-top: calc(var(--scroll) * -0.08);
  }

  :global(html[data-pin="on"]) .home-section--contact {
    scroll-margin-top: calc(var(--scroll) * -0.12);
  }

  /* Beats: cards a section steps through while pinned (one shown at a time). */
  :global(html[data-pin="on"]) .home-section__body :global([data-beat]) {
    opacity: 0;
    transition: opacity var(--t-ui) var(--ease-inout);
  }

  :global(html[data-pin="on"]) .home-section__body :global([data-beat][data-beat-active]),
  :global(html[data-pin="on"]) .home-section__body :global([data-beat]:focus-within) {
    opacity: 1;
  }

  /* A beat that is not shown never catches the pointer meant for the one that is. */
  :global(html[data-pin="on"])
    .home-section__body
    :global([data-beat]:not([data-beat-active], :focus-within)),
  :global(html[data-pin="on"])
    .home-section__body
    :global([data-beat]:not([data-beat-active], :focus-within) *) {
    pointer-events: none;
  }
</style>
