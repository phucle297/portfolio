---
/**
 * Head preload for the first section's still, the LCP candidate (PF-02, PF-47). The `<img>` sits
 * ~57 KB into the HTML, after the inline head CSS and scripts, so without this its request waits
 * for the parser to reach it; WebKit can by then have started the next, lazy still (it is within
 * the lazy-load margin of a phone viewport). Declared in `<head>` it is requested before any
 * layout, at high priority, in every engine. Same srcset/sizes as the `<picture>`, so the browser
 * picks the same candidate and the `<img>` reuses this response (no second fetch).
 */
import {
  DESKTOP_STILL_MEDIA,
  MOBILE_STILL_MEDIA,
  introStillPlaceholder,
  sectionStillImages,
} from "../lib/still-images";

const { desktop, mobile } = await sectionStillImages(0);
const placeholder = await introStillPlaceholder();
// PF-57: the intro still's placeholder as the body background, from the head, so it is there even
// in a first frame painted before the Hello section has streamed in (Slow 4G). Same crop as the
// intro <picture>: desktop sticky full-viewport cover, phone full-width from the top. Removed once
// the intro AVIF has loaded (SectionStill's onload), so it never shows behind later sections.
// Only with JS (html.js): without it nothing would remove it.
const bodyPlaceholder =
  `html.js:not(.still0-loaded) body{background-image:url("${placeholder.desktop}");` +
  "background-position:center;background-size:cover;background-repeat:no-repeat;" +
  "background-attachment:fixed}" +
  `@media ${MOBILE_STILL_MEDIA}{html.js:not(.still0-loaded) body{` +
  `background-image:url("${placeholder.mobile}");background-position:center top;` +
  "background-size:100% auto;background-attachment:scroll}}";
---

<link
  rel="preload"
  as="image"
  type="image/avif"
  media={MOBILE_STILL_MEDIA}
  imagesrcset={mobile.srcSet.attribute}
  imagesizes="100vw"
  fetchpriority="high"
/>
<link
  rel="preload"
  as="image"
  type="image/avif"
  media={DESKTOP_STILL_MEDIA}
  imagesrcset={desktop.srcSet.attribute}
  imagesizes="100vw"
  fetchpriority="high"
/>
<style is:inline set:html={bodyPlaceholder} />
