---
import { Image } from "astro:assets";
import type { Project } from "../model/projects";

interface Props {
  project: Project;
  delay?: number;
}
const { project, delay = 0 } = Astro.props;
---

<article class="project-card" data-reveal data-reveal-delay={String(delay)}>
  <div class="project-card__media">
    <Image
      src={project.image}
      alt={project.imageAlt}
      widths={[400, 640, 960]}
      sizes="(min-width: 1100px) 340px, (min-width: 720px) 45vw, 92vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="project-card__body">
    <h3 class="project-card__title">
      {project.href ? <a href={project.href}>{project.title}</a> : project.title}
    </h3>
    <p class="project-card__summary">{project.summary}</p>
    <ul class="project-card__tags" role="list" aria-label="Technologies">
      {project.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .project-card:hover {
    border-color: rgb(158 197 255 / 0.4);
    box-shadow: 0 20px 50px -20px rgb(124 92 255 / 0.45);
  }

  .project-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.04);
  }

  .project-card__body {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .project-card__title {
    margin: 0;
    font-size: 1.25rem;
  }

  .project-card__summary {
    margin: 0;
    color: var(--color-text-muted);
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-card__tags li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-size: 0.8rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__media img {
      transition: none;
    }

    .project-card:hover .project-card__media img {
      transform: none;
    }
  }
</style>
