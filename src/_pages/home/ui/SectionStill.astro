---
/**
 * Poster still for one section: the same darkroom scene at that section's key state
 * (design.md §7, §8). Desktop: a 1440×900 still pinned behind the section. Mobile: a portrait
 * intro still or a 390×240 band. AVIF via astro:assets. Hidden on the full tier, where the live
 * canvas takes over (hidden lazy images are never fetched).
 *
 * With JS at ≥ 768 px the stills are viewport-fixed and cross-fade (320 ms, never black) to the
 * still of the section under the scroll position; see `lib/still-crossfade.ts`. Without JS each
 * still stays sticky inside its own section.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import d0 from "./stills/d-0.png";
import d1 from "./stills/d-1.png";
import d2 from "./stills/d-2.png";
import d3 from "./stills/d-3.png";
import d4 from "./stills/d-4.png";
import d5 from "./stills/d-5.png";
import m0 from "./stills/m-0.png";
import m1 from "./stills/m-1.png";
import m2 from "./stills/m-2.png";
import m3 from "./stills/m-3.png";
import m4 from "./stills/m-4.png";
import m5 from "./stills/m-5.png";

interface Props {
  index: number;
  /** The first section's still is the LCP candidate: eager, high priority. */
  eager?: boolean;
}

const DESKTOP: readonly ImageMetadata[] = [d0, d1, d2, d3, d4, d5];
const MOBILE: readonly ImageMetadata[] = [m0, m1, m2, m3, m4, m5];

const { index, eager = false } = Astro.props;
const desktopSrc = DESKTOP[index];
const mobileSrc = MOBILE[index];
if (!desktopSrc || !mobileSrc) throw new Error(`No still for section ${index}`);

const desktop = await getImage({
  src: desktopSrc,
  format: "avif",
  quality: 55,
  widths: [960, 1440],
});
const mobile = await getImage({ src: mobileSrc, format: "avif", quality: 55, widths: [390] });
---

<div class:list={["still", { "still--intro": index === 0 }]} data-still={index} aria-hidden="true">
  <picture>
    <source
      media="(max-width: 767px)"
      srcset={mobile.srcSet.attribute}
      sizes="100vw"
      type="image/avif"
      width={mobileSrc.width}
      height={mobileSrc.height}
    />
    <img
      src={desktop.src}
      srcset={desktop.srcSet.attribute}
      sizes="100vw"
      width={desktopSrc.width}
      height={desktopSrc.height}
      alt=""
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding={eager ? "sync" : "async"}
    />
  </picture>
</div>

<script>
  import { initStillCrossfade } from "../lib/still-crossfade";

  initStillCrossfade();
</script>

<style>
  .still {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .still picture {
    position: sticky;
    top: 0;
    display: block;
    height: 100vh;
  }

  .still img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Overlays per scene, from the design source (round7 darkroom-morph): the intro gets only an
     edge fade (poster.html's .top on desktop, mobile.html's 110 px top fade on phones); sections
     2-6 get dr.css's .veil on desktop and mobile.html's .band:after on phones (QA-PF02-1). */
  .still {
    --still-veil:
      radial-gradient(ellipse at center, rgb(14 10 8 / 0.55), rgb(14 10 8 / 0.82) 70%),
      linear-gradient(
        180deg,
        rgb(14 10 8 / 0.9),
        rgb(14 10 8 / 0) 18%,
        rgb(14 10 8 / 0) 82%,
        rgb(14 10 8 / 0.95)
      );
  }

  .still--intro {
    --still-veil: linear-gradient(
      180deg,
      rgb(14 10 8 / 0.92),
      rgb(14 10 8 / 0) 130px,
      rgb(14 10 8 / 0) calc(100% - 160px),
      rgb(14 10 8 / 0.92)
    );
  }

  .still::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--still-veil);
  }

  :global(html[data-tier="full"]) .still {
    display: none;
  }

  /* Static tier with JS, desktop and tablet: one viewport-fixed still at a time, cross-faded. */
  @media (min-width: 768px) {
    :global(html.js) .still picture {
      position: fixed;
      inset: 0;
      display: none;
      opacity: 0;
    }

    /* Displayed (so the lazy image loads) but transparent until shown: the shown still and its
       neighbours, and the intro still before the script has picked a section. */
    :global(html.js:not([data-still-active])) .still--intro picture,
    :global(html.js) .still.is-near picture,
    :global(html.js) .still.is-shown picture {
      display: block;
    }

    /* Before the script picks the section, the intro still (the LCP image) is the one shown. */
    :global(html.js:not([data-still-active])) .still--intro picture,
    :global(html.js) .still.is-shown picture {
      opacity: 1;
    }

    /* The cross-fade is a Web Animation (lib/still-crossfade.ts); no CSS transition may delay an
       opacity change, not even the global reduced-motion 0.01ms one. */
    :global(html.js) .still picture {
      transition: none !important;
    }

    /* Fixed stills: the scene's overlay moves onto the fixed picture, so it spans the viewport the
       way the design's section overlay spans a 900 px section. */
    :global(html.js) .still::after {
      display: none;
    }

    :global(html.js) .still picture::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--still-veil);
    }
  }

  @media (max-width: 767px) {
    .still {
      position: relative;
      inset: auto;
      --still-veil: linear-gradient(180deg, rgb(14 10 8 / 0.2), var(--bg));
    }

    .still picture {
      position: static;
      height: auto;
    }

    .still img {
      height: auto;
      aspect-ratio: 390 / 240;
    }

    .still--intro {
      position: absolute;
      inset: 0 0 auto;
      --still-veil: linear-gradient(180deg, rgb(14 10 8 / 0.9), rgb(14 10 8 / 0) 110px);
    }

    .still--intro img {
      aspect-ratio: 390 / 1010;
    }
  }
</style>
