---
import { work } from "@entities/profile";
import HomeSection from "./HomeSection.astro";
---

<HomeSection id="work" index={2} labelledBy="work-title">
  <p class="eyebrow">{work.eyebrow}</p>
  <h2 id="work-title" class="display section-title">
    {work.title} <em>{work.titleAccent}</em>
  </h2>
  <ul class="work__cases" role="list">
    {work.cases.map((item, i) => (
      <li class="card work__case" data-reveal>
        <article>
          <p class="eyebrow">
            Print 0{i + 1} · {item.context}
          </p>
          <h3>{item.title}</h3>
          {item.domains ? (
            <ul class="work__domains" role="list">
              {item.domains.map((domain) => (
                <li>
                  <b>{domain.title}</b> <span>{domain.line}</span>
                </li>
              ))}
            </ul>
          ) : (
            <>
              <p class="work__copy">{item.copy}</p>
              <p class="work__tags mono">{item.tags}</p>
            </>
          )}
          {item.href && (
            <a class="work__link" href={item.href}>
              {work.readCase}
            </a>
          )}
        </article>
      </li>
    ))}
  </ul>
</HomeSection>

<style>
  .work__cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .work__case h3 {
    margin: 0.5rem 0;
    font: 400 2.25rem/1.05 var(--font-serif);
  }

  .work__copy {
    color: var(--muted);
  }

  .work__domains {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
  }

  .work__domains li {
    display: grid;
    gap: 0.125rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--line);
  }

  .work__domains li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .work__domains b {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--text);
  }

  .work__domains span {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .work__tags {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .work__link {
    display: inline-flex;
    margin-top: 0.75rem;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  /* ---------- Pinned (full tier): heading top left, the four prints' cards along the bottom,
     under the drying line. ---------- */
  :global(html[data-pin="on"]) .work__cases {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: auto;
  }

  :global(html[data-pin="on"]) .work__case {
    padding: 0.9rem 1.1rem;
  }

  :global(html[data-pin="on"]) .work__case .eyebrow {
    font-size: 0.6875rem;
  }

  :global(html[data-pin="on"]) .work__case h3 {
    margin: 0.3rem 0;
    font-size: 1.45rem;
  }

  :global(html[data-pin="on"]) .work__copy {
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  :global(html[data-pin="on"]) .work__domains {
    margin-top: 0.375rem;
    gap: 0.3125rem;
  }

  :global(html[data-pin="on"]) .work__domains li {
    display: block;
    padding-top: 0;
    border-top: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  :global(html[data-pin="on"]) .work__domains b,
  :global(html[data-pin="on"]) .work__domains span {
    font-size: inherit;
    line-height: inherit;
  }

  :global(html[data-pin="on"]) .work__domains b::after {
    content: " ";
  }

  :global(html[data-pin="on"]) .work__tags {
    margin-top: 0.6rem;
  }

  @media (max-width: 767px) {
    .work__cases {
      grid-template-columns: 1fr;
    }
  }
</style>
