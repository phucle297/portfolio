---
import { education, journey, profile, roles, skills } from "@entities/profile";
import HomeSection from "./HomeSection.astro";
---

<HomeSection id="journey" index={1} labelledBy="journey-title">
  <div class="journey">
    <div class="journey__intro">
      <p class="eyebrow">{journey.eyebrow}</p>
      <h2 id="journey-title" class="display section-title">
        {journey.title} <em>{journey.titleAccent}</em>
      </h2>
      <p class="journey__text">{journey.intro}</p>
      <div class="journey__meta">
        {profile.photo && (
          <img src={profile.photo} alt={profile.fullName} width="320" height="400" loading="lazy" />
        )}
        <p class="mono">
          <span>{profile.fullName}</span>
          <span>{profile.city}</span>
          <span>{profile.timezone}</span>
        </p>
      </div>
      <ul class="journey__skills" role="list" aria-label="Skills">
        {skills.map((skill) => (
          <li class="chip">{skill}</li>
        ))}
      </ul>
    </div>
    <div class="journey__timeline">
      <ol class="journey__roles" role="list">
        {roles.map((role) => (
          <li class="card frame" data-reveal>
            <article>
              <p class="eyebrow">
                {role.years} · {role.company}
              </p>
              <h3>{role.title}</h3>
              <p>{role.copy}</p>
            </article>
          </li>
        ))}
      </ol>
      <div class="card journey__edu">
        <h3 class="eyebrow">Education</h3>
        <ul role="list">
          {education.map((item) => (
            <li>
              <strong>{item.degree}</strong> · {item.school} · {item.years}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</HomeSection>

<style>
  .journey {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .journey__intro {
    display: grid;
    gap: 1.25rem;
  }

  .journey__text {
    color: var(--muted);
  }

  .journey__meta {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .journey__meta p {
    display: grid;
    gap: 0.25rem;
    color: var(--muted);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .journey__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey__roles {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .frame {
    position: relative;
    padding-left: 3.5rem;
  }

  .frame::before {
    content: "";
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 1.25rem;
    width: 12px;
    background: repeating-linear-gradient(
      180deg,
      rgb(255 194 75 / 0.55) 0 10px,
      transparent 10px 22px
    );
  }

  .frame h3,
  .journey__edu h3 {
    margin: 0.4rem 0;
    font: 400 1.75rem/1.1 var(--font-serif);
  }

  .journey__edu h3 {
    font: 500 0.8125rem/1.4 var(--font-mono);
  }

  .frame p:last-child,
  .journey__edu li {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .journey__edu {
    margin-top: 0.75rem;
  }

  .journey__edu ul {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey__edu strong {
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 767px) {
    .journey {
      grid-template-columns: 1fr;
    }

    .journey__skills {
      display: none;
    }
  }
</style>
