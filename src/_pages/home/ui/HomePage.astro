---
import DarkroomScene from "./DarkroomScene.astro";
import ContactSection from "./ContactSection.astro";
import HelloSection from "./HelloSection.astro";
import JourneySection from "./JourneySection.astro";
import ProcessSection from "./ProcessSection.astro";
import SectionRail from "./SectionRail.astro";
import ServicesSection from "./ServicesSection.astro";
import WorkSection from "./WorkSection.astro";
---

<DarkroomScene />
<div class="home-scrim" aria-hidden="true"></div>
<div class="home-progress" aria-hidden="true">
  <span data-progress></span>
</div>
<SectionRail />
<HelloSection />
<JourneySection />
<WorkSection />
<ServicesSection />
<ProcessSection />
<ContactSection />

<!--
  Progress fill: CSS scroll timeline is the default (works with and without JS). With JS, a tiny inline fallback (rAF-throttled, transform only, no header layout reads
  on scroll) always drives the fill so it works even if the timeline API is missing or
  inert. No module import, so this does not add to the initial JS budget.
-->
<script is:inline>
  (function () {
    const fill = document.querySelector("[data-progress]");
    const root = fill && fill.parentElement;
    if (!fill || !root) return;
    let max = 0;
    let queued = false;
    const measure = function () {
      max = document.documentElement.scrollHeight - window.innerHeight;
    };
    const paint = function () {
      queued = false;
      if (root.hasAttribute("data-progress-js")) return;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      fill.style.transform = "scaleX(" + p.toFixed(4) + ")";
    };
    const onScroll = function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };
    measure();
    paint();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", function () {
      measure();
      onScroll();
    });
  })();
</script>

<style>
  /* Text over the scene always sits on a scrim (design.md Tokens), limited to the left
     ~740 px at 1600 so it never dims the scene's subject. */
  .home-scrim {
    display: none;
  }

  @media (min-width: 768px) {
    .home-scrim {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 1;
      display: block;
      width: max(46.25vw, 30rem);
      /* design.md: .86 up to 38% of 1600 (608 px), fading out; cut at 740 px. */
      background: linear-gradient(90deg, rgb(14 10 8 / 0.86) 0 82%, transparent 100%);
      pointer-events: none;
    }
  }

  /* Pinned copy brings its own per-section scrims. */
  :global(html[data-pin="on"]) .home-scrim {
    display: none;
  }

  /* Scroll progress line: fixed flush under the header (PF-27). Takes no layout space.
     --header-bottom is the header's real bottom edge, set before first paint and kept in
     sync on resize, so the bar is never behind the header and survives header-height
     changes (mobile, scrolled state, later PF-11). Shown on every tier, including static. */
  .home-progress {
    position: fixed;
    top: var(--header-bottom, var(--header-h));
    right: 0;
    left: 0;
    z-index: 21;
    display: block;
    height: 2px;
    background: var(--line);
    pointer-events: none;
  }

  .home-progress span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* CSS scroll timeline drives the fill without JS. Longhands (not the animation shorthand)
     so the bundler cannot drop animation-duration; scroll-driven animations need `auto`. */
  @supports (animation-timeline: scroll()) {
    .home-progress span {
      animation-name: home-progress-fill;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll();
    }
  }

  @keyframes home-progress-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Full-tier copy layer takes over with the scene's smoothed p. */
  .home-progress[data-progress-js] span {
    animation: none;
  }

  /* No JS and no scroll-timeline: hide the track so it never sits stuck empty or full. */
  :global(html:not(.js)) .home-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    :global(html:not(.js)) .home-progress {
      display: block;
    }
  }

  /* The global reduced-motion rule would force animation-duration: 0.01ms and freeze a
     scroll-driven fill. This is a position indicator, not decorative motion. */
  @media (prefers-reduced-motion: reduce) {
    .home-progress span {
      transition: none;
      animation-duration: unset;
    }

    @supports (animation-timeline: scroll()) {
      .home-progress span {
        animation-duration: unset !important;
      }
    }
  }
</style>
