---
import DarkroomScene from "./DarkroomScene.astro";
import ContactSection from "./ContactSection.astro";
import HelloSection from "./HelloSection.astro";
import JourneySection from "./JourneySection.astro";
import ProcessSection from "./ProcessSection.astro";
import SectionRail from "./SectionRail.astro";
import ServicesSection from "./ServicesSection.astro";
import WorkSection from "./WorkSection.astro";
---

<DarkroomScene />
<div class="home-scrim" aria-hidden="true"></div>
<div class="home-progress" aria-hidden="true">
  <span data-progress></span>
</div>
<SectionRail />
<HelloSection />
<JourneySection />
<WorkSection />
<ServicesSection />
<ProcessSection />
<ContactSection />

<script>
  import { initProgressBar } from "../lib/progress-bar";
  initProgressBar();
</script>

<style>
  /* Text over the scene always sits on a scrim (design.md Tokens), limited to the left
     ~740 px at 1600 so it never dims the scene's subject. */
  .home-scrim {
    display: none;
  }

  @media (min-width: 768px) {
    .home-scrim {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 1;
      display: block;
      width: max(46.25vw, 30rem);
      /* design.md: .86 up to 38% of 1600 (608 px), fading out; cut at 740 px. */
      background: linear-gradient(90deg, rgb(14 10 8 / 0.86) 0 82%, transparent 100%);
      pointer-events: none;
    }
  }

  /* Pinned copy brings its own per-section scrims. */
  :global(html[data-pin="on"]) .home-scrim {
    display: none;
  }

  /* Scroll progress line: fixed flush under the header (PF-27). Takes no layout space.
     --header-bottom is the header's real bottom edge, set before first paint and kept in
     sync on resize, so the bar is never behind the header and survives header-height
     changes (mobile, scrolled state, later PF-11). Shown on every tier. */
  .home-progress {
    position: fixed;
    top: var(--header-bottom, var(--header-h));
    right: 0;
    left: 0;
    z-index: 21;
    display: block;
    height: 2px;
    background: var(--line);
    pointer-events: none;
  }

  .home-progress span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-progress span {
      transition: none;
    }
  }
</style>
