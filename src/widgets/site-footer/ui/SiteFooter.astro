---
import { hello, profile } from "@entities/profile";

const linkedin = profile.socials.find((social) => social.label === "LinkedIn");
const cvHref = profile.cvUrl ?? linkedin?.href ?? null;
const cvLabel = profile.cvUrl ? hello.secondaryCta : hello.secondaryCtaFallback;
---

<footer class="site-footer" data-site-footer>
  <div class="site-footer__inner">
    <p>
      © 2026 {profile.name} · {profile.city}
    </p>
    <ul class="site-footer__links" role="list">
      {cvHref && (
        <li>
          <a href={cvHref} rel="noopener noreferrer" target="_blank">
            {cvLabel}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      )}
      {profile.socials.map((social) => (
        <li>
          <a href={social.href} rel="me noopener noreferrer" target="_blank">
            {social.label}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  /* Pinned copy (full tier): the footer sticks to the bottom of the viewport and fades in with
     the Contact copy (the copy layer writes --footer-o), so it never scrolls in under the pinned
     scene at the end of the page. */
  :global(html[data-pin="on"]) .site-footer {
    position: sticky;
    bottom: 0;
    opacity: var(--footer-o, 0);
    pointer-events: none;
  }

  :global(html[data-pin="on"]) .site-footer[data-footer-active] {
    pointer-events: auto;
  }

  :global(html[data-pin="on"]) .site-footer:focus-within {
    opacity: 1;
  }

  .site-footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: var(--footer-h);
    border-top: 1px solid var(--line);
    background: rgb(14 10 8 / 0.85);
    color: var(--muted);
    font: 500 0.75rem/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    width: 100%;
    padding-inline: var(--gutter);
  }

  .site-footer__links {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    color: var(--accent-2);
  }
</style>
