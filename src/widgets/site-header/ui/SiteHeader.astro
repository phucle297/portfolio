---
import { profile } from "@entities/profile";
import { siteConfig } from "@shared/config";

interface Props {
  /** Prefix for section anchors: "" on the home page, "/" elsewhere. */
  anchorBase?: string;
}
const { anchorBase = "" } = Astro.props;
---

<header class="site-header" data-at-top>
  <div class="site-header__inner">
    <a class="site-header__brand" href={anchorBase === "" ? "#hello" : "/"}>
      {profile.name}
      <span aria-hidden="true">.</span>
    </a>
    <nav class="site-header__nav" aria-label="Main">
      <ul role="list">
        {siteConfig.nav.map((item) => (
          <li>
            <a href={`${anchorBase}#${item.id}`} data-section-link={item.id}>
              <span class="site-header__num">{item.number}</span> {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-header__actions">
      <button type="button" class="site-header__toggle" data-motion-toggle aria-pressed="true">
        <span class="site-header__switch" aria-hidden="true"></span>
        Motion{" "}
        <span class="site-header__state" data-motion-state>
          on
        </span>
      </button>
      <button
        type="button"
        class="site-header__toggle site-header__safelight"
        data-safelight-toggle
        aria-pressed="true"
        hidden
      >
        <span class="site-header__bulb" aria-hidden="true">
          ●
        </span>
        Safelight
      </button>
      <a class="site-header__pill" href={`${anchorBase}#contact`}>
        <span class="site-header__dot" aria-hidden="true"></span>
        <span class="site-header__pill-full">Open for freelance</span>
        <span class="site-header__pill-short">Freelance</span>
      </a>
      <button
        type="button"
        class="site-header__menu-btn"
        data-menu-open
        aria-expanded="false"
        aria-controls="site-menu-sheet"
        aria-haspopup="dialog"
      >
        MENU <span aria-hidden="true">≡</span>
      </button>
    </div>
  </div>
  <dialog
    class="menu-sheet"
    id="site-menu-sheet"
    data-menu-sheet
    aria-labelledby="site-menu-title"
    tabindex="-1"
  >
    <div class="menu-sheet__bar">
      <h2 id="site-menu-title" class="menu-sheet__title">
        Menu
      </h2>
      <button type="button" class="menu-sheet__close" data-menu-close>
        Close
      </button>
    </div>
    <ul class="menu-sheet__list" role="list">
      {siteConfig.nav.map((item) => (
        <li>
          <a href={`${anchorBase}#${item.id}`} data-section-link={item.id}>
            <span class="menu-sheet__num" aria-hidden="true">
              {item.number}
            </span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </dialog>
</header>

<script>
  import {
    motionAllowed,
    onMotionChange,
    onSafelightChange,
    prefersReducedMotion,
    safelightOn,
    setSafelight,
    setUserMotion,
  } from "@shared/lib/motion";
  import { initMenuSheet } from "../lib/menu-sheet";

  const toggle = document.querySelector<HTMLButtonElement>("[data-motion-toggle]");
  const state = toggle?.querySelector<HTMLElement>("[data-motion-state]");

  const render = (): void => {
    if (!toggle || !state) return;
    const on = motionAllowed();
    const locked = prefersReducedMotion();
    toggle.setAttribute("aria-pressed", String(on));
    toggle.disabled = locked;
    toggle.title = locked ? "Reduced motion is on in your system settings" : "";
    state.textContent = on ? "on" : "off";
    document.documentElement.classList.toggle("motion-ok", on);
  };

  const header = document.querySelector<HTMLElement>(".site-header");
  if (header) {
    let queued = false;
    const syncTop = (): void => {
      queued = false;
      header.toggleAttribute("data-at-top", window.scrollY < 8);
    };
    window.addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(syncTop);
      },
      { passive: true },
    );
    syncTop();
    initMenuSheet(header);
  }

  if (toggle) {
    toggle.addEventListener("click", () => {
      setUserMotion(!motionAllowed());
    });
    onMotionChange(render);
    render();
  }

  // Safelight: only meaningful while the 3D scene runs (CSS hides it on the static tier).
  const safelight = document.querySelector<HTMLButtonElement>("[data-safelight-toggle]");
  if (safelight) {
    const renderSafelight = (): void => {
      safelight.setAttribute("aria-pressed", String(safelightOn()));
    };
    safelight.hidden = false;
    safelight.addEventListener("click", () => {
      setSafelight(!safelightOn());
    });
    onSafelightChange(renderSafelight);
    renderSafelight();
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    /* Opaque bar so copy scrolling underneath never shows through (QA-7); only at the very top
       of the page, where nothing sits under it, it softens into the design's gradient. */
    border-bottom: 1px solid var(--line);
    background: rgb(14 10 8 / 0.97);
    transition:
      background-color var(--t-ui) var(--ease-inout),
      border-color var(--t-ui) var(--ease-inout);
  }

  /* data-at-top ships in the HTML (pages load at the top), so the first paint already has the
     right state; the scroll script keeps it current. Gated on html.js (set before first paint)
     so that without JS, where nothing would clear it on scroll, the bar stays opaque; and on
     html:not([data-scrolled]) (the inline head script, from the first scroll event) so a
     scrolled position restored before this module script runs keeps it opaque too (QA B-8). */
  :global(html.js:not([data-scrolled])) .site-header[data-at-top] {
    border-bottom-color: transparent;
    background: linear-gradient(180deg, rgb(14 10 8 / 0.94) 0 72%, rgb(14 10 8 / 0));
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
    padding-inline: var(--gutter);
  }

  .site-header__brand {
    font: 400 1.6rem/1 var(--font-serif);
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__brand span {
    color: var(--accent);
  }

  .site-header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .site-header__nav ul {
    display: flex;
    gap: clamp(0.5rem, 2vw, 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: inline-flex;
    gap: 0.3em;
    align-items: center;
    min-height: 2.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--t-micro) var(--ease-out);
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current="true"] {
    color: var(--accent-2);
  }

  .site-header__actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .site-header__toggle,
  .site-header__pill,
  .site-header__menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  /* The Motion toggle needs JS: without it (no "js" class from the inline head script) it is
     not shown at all (QA-4). */
  :global(html:not(.js)) .site-header__toggle {
    display: none;
  }

  .site-header__toggle {
    border: 1px solid var(--line-strong);
    background: rgb(14 10 8 / 0.6);
    color: var(--text);
    cursor: pointer;
  }

  .site-header__toggle:disabled {
    cursor: not-allowed;
  }

  .site-header__switch {
    position: relative;
    width: 26px;
    height: 14px;
    border-radius: 7px;
    background: var(--line-strong);
  }

  .site-header__switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--text);
    transition: transform var(--t-micro) var(--ease-out);
  }

  .site-header__toggle[aria-pressed="true"] .site-header__switch {
    background: var(--accent-2);
  }

  .site-header__toggle[aria-pressed="true"] .site-header__switch::after {
    transform: translateX(12px);
    background: var(--ink);
  }

  /* Safelight only exists while the 3D scene runs. */
  :global(html:not([data-tier="full"])) .site-header__safelight {
    display: none;
  }

  .site-header__bulb {
    color: var(--muted);
    transition: color var(--t-micro) var(--ease-out);
  }

  .site-header__safelight[aria-pressed="true"] .site-header__bulb {
    color: var(--accent);
    text-shadow: 0 0 10px var(--accent);
  }

  .site-header__pill {
    border: 1px solid rgb(255 194 75 / 0.45);
    background: rgb(14 10 8 / 0.6);
    color: var(--accent-2);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    letter-spacing: 0;
    text-decoration: none;
  }

  .site-header__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 12px var(--accent-2);
  }

  /* Short "Freelance" label is phone-only; one of the two spans is `display: none` so the
     accessible name is never both strings at once. */
  .site-header__pill-short {
    display: none;
  }

  /* MENU is phone-only and needs JS (the sheet is a <dialog>). Without JS the desktop nav
     stays visible, including below 767 px, so the six section links remain reachable. */
  .site-header__menu-btn {
    display: none;
    min-width: 2.75rem;
    border: 1px solid var(--line-strong);
    background: rgb(14 10 8 / 0.6);
    color: var(--text);
    cursor: pointer;
  }

  @media (max-width: 1100px) {
    .site-header__num {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .site-header__inner {
      flex-wrap: wrap;
      gap: 0 1rem;
      padding-block: 0.5rem;
    }

    .site-header__nav {
      order: 3;
      flex-basis: 100%;
      justify-content: flex-start;
      overflow-x: auto;
    }

    .site-header__actions {
      margin-left: auto;
    }

    .site-header__toggle {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .site-header__pill-full {
      display: none;
    }

    .site-header__pill-short {
      display: inline;
    }

    /* With JS: logo + Freelance pill + MENU on one row; the section rail and skill chips are
       hidden by their own components at this width. */
    :global(html.js) .site-header__inner {
      flex-wrap: nowrap;
      gap: 0.75rem;
      padding-block: 0;
    }

    :global(html.js) .site-header__nav {
      display: none;
    }

    :global(html.js) .site-header__menu-btn {
      display: inline-flex;
    }
  }

  /* ---------- Mobile menu sheet (full-screen dialog; not in flow, so open/close has no CLS) ----------
     position: fixed / inset: 0 keeps the sheet out of .site-header's border box. PF-27 (PR #18)
     sets --header-bottom from that box; opening the sheet must not move it.
     z-index 22 keeps the sheet and its backdrop above PF-27's progress bar (z-index 21).
     The header itself is 20, so the modal top layer plus this z-index is what stacks above the bar. */
  .menu-sheet {
    position: fixed;
    inset: 0;
    z-index: 22;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--text);
  }

  .menu-sheet::backdrop {
    z-index: 22;
    background: var(--bg);
  }

  .menu-sheet__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
    padding-inline: var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  .menu-sheet__title {
    font: 400 1.6rem/1 var(--font-serif);
  }

  .menu-sheet__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(14 10 8 / 0.6);
    color: var(--text);
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .menu-sheet__list {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 1.25rem var(--gutter) 2rem;
    list-style: none;
  }

  .menu-sheet__list a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 2.75rem;
    padding-block: 0.55rem;
    color: var(--text);
    font: 400 2rem/1 var(--font-serif);
    text-decoration: none;
  }

  .menu-sheet__list a:hover,
  .menu-sheet__list a[aria-current="true"] {
    color: var(--accent-2);
  }

  .menu-sheet__num {
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--accent-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-sheet {
      transition: none;
    }
  }
</style>
