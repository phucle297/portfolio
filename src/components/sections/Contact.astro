---
import Section from "@/components/Section.astro";
import { site } from "@/lib/site";
---

<Section id="contact" title="Let’s work together" eyebrow="Contact">
  <div class="contact" data-reveal data-reveal-delay="80">
    <p>
      Have a project in mind or just want to say hello? My inbox is open. I usually reply within a
      couple of days.
    </p>
    <a class="button button--primary" href={`mailto:${site.email}`}>
      Email me
    </a>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    max-width: 60ch;
  }

  .contact p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }
</style>
