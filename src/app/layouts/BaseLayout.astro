---
import serifItalicWoff2 from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import serifWoff2 from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import "../styles/global.css";
import { profile } from "@entities/profile";
import { siteConfig } from "@shared/config";
import { SkipLink } from "@shared/ui";
import { SiteFooter } from "@widgets/site-footer";
import { SiteHeader } from "@widgets/site-header";

interface Props {
  title?: string;
  description?: string;
  /** Path (relative to the site root) or absolute URL of the social preview image. */
  image?: string;
  /** Prefix for section anchors in the header: "" on the home page, "/" elsewhere. */
  anchorBase?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  anchorBase = "/",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang={siteConfig.locale} data-tier="static">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- The H1 faces (Instrument Serif roman + italic, Latin subset). -->
    <link rel="preload" href={serifWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicWoff2} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script is:inline>
      // Enable motion-dependent styles only when JS runs and motion is allowed by both the OS
      // setting and the site's Motion toggle (localStorage "motion" = "off" switches it off).
      (function () {
        // Marks "JS runs" before first paint, so JS-only controls (the Motion toggle) take their
        // space from the start instead of shifting the header when a module script reveals them.
        const root = document.documentElement;
        root.classList.add("js");
        let off = false;
        try {
          off = localStorage.getItem("motion") === "off";
        } catch {
          off = false;
        }
        if (!off && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.classList.add("motion-ok");
        }
        // The header softens into a see-through gradient only at the very top (SiteHeader).
        // html[data-scrolled] keeps it opaque over the copy before the header's module script
        // runs (QA B-8): from any scroll away from the top, and on reloads, history navigations
        // and #anchor links, where the browser restores or jumps to a scrolled position later
        // in the load (not always with a scroll event), until the page has loaded.
        const nav = performance.getEntriesByType("navigation")[0];
        let restoring =
          location.hash !== "" ||
          (nav instanceof PerformanceNavigationTiming &&
            (nav.type === "reload" || nav.type === "back_forward"));
        const syncScrolled = function () {
          root.toggleAttribute("data-scrolled", restoring || window.scrollY >= 8);
        };
        syncScrolled();
        window.addEventListener("scroll", syncScrolled, { passive: true });
        if (restoring) {
          window.addEventListener(
            "load",
            function () {
              requestAnimationFrame(function () {
                restoring = false;
                syncScrolled();
              });
            },
            { once: true },
          );
        }
      })();
    </script>
  </head>
  <body>
    <SkipLink />
    <SiteHeader anchorBase={anchorBase} />
    <script is:inline>
      // Measure the header's real bottom before first paint so the progress bar (and anything
      // else that uses --header-bottom) is flush under it, including a restored scroll position
      // where html[data-scrolled] has already been set in the head script (QA B-8).
      (function () {
        const header = document.querySelector(".site-header");
        if (!header) return;
        const sync = function () {
          document.documentElement.style.setProperty(
            "--header-bottom",
            Math.round(header.getBoundingClientRect().bottom) + "px",
          );
        };
        sync();
        window.addEventListener("resize", sync);
        if (typeof ResizeObserver === "function") new ResizeObserver(sync).observe(header);
      })();
    </script>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <script>
      import { startClient } from "../entrypoint/client";
      startClient();
    </script>
  </body>
</html>
