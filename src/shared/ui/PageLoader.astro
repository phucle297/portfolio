---
/**
 * PF-67 first-open loader, "the print develops" (design/loading/design.md).
 *
 * A fixed cover in the page background colour, opaque from first paint (this component's CSS is
 * inlined in <head> with the rest; render it as the first child of <body>). Its content fades in
 * only after 300 ms, so a fast load never shows a loader. It leaves once the page is ready: web
 * fonts in, and the first section's visual shown (the intro still decoded, or the scene loader
 * settled), or after the 3 s hard cap. A CSS failsafe hides it at 3.2 s even if this script dies,
 * and without JS it never shows. The page lays out and paints normally beneath it: the cover is
 * position: fixed and the exit is opacity only, so nothing on the page moves.
 *
 * Screen readers: #main is aria-busy and a polite status says "Loading the page", then
 * "Page loaded". The cover is aria-hidden and has nothing focusable; the skip link (z-index 100)
 * stays above it.
 */
---

<div class="loader" aria-hidden="true">
  <div class="loader__glow"></div>
  <div class="loader__in">
    <div class="loader__print">
      <i class="loader__burst"></i>
      <i class="loader__plate"></i>
    </div>
    <p class="loader__cap">DEVELOPING</p>
    <div class="loader__timer"></div>
  </div>
</div>
<p class="visually-hidden" role="status" aria-live="polite" data-load-status></p>
<script is:inline>
  (function () {
    const d = document;
    const h = d.documentElement;
    let done = false;
    let fontsIn = false;
    let main = null;
    let status = null;
    if (!h.classList.contains("js")) return;
    const ready = function () {
      if (done) return;
      done = true;
      // Ready before the content (glow, print, caption, timer) has fully faded in: drop it at
      // once and fade only the cover, so a fast load never shows the content mid-reveal.
      const inner = d.querySelector(".loader__in");
      const reveal = inner && inner.getAnimations ? inner.getAnimations() : [];
      if (
        reveal.some(function (a) {
          return a.playState !== "finished";
        })
      )
        h.classList.add("is-early");
      h.classList.add("is-ready");
      if (main) main.removeAttribute("aria-busy");
      if (status) status.textContent = "Page loaded";
      setTimeout(function () {
        const loader = d.querySelector(".loader");
        if (loader) loader.remove();
      }, 400);
    };
    // Ready = fonts in AND the first section's visual is shown: the intro still decoded
    // (html.still0-loaded) or the scene loader settled (data-scene-load). Pages without an intro
    // still (404) only wait for the fonts. This is the one place that decides it.
    const check = function () {
      if (
        fontsIn &&
        (!d.querySelector('[data-still="0"]') ||
          h.classList.contains("still0-loaded") ||
          /^(ready|failed|off)$/.test(h.dataset.sceneLoad || ""))
      )
        ready();
    };
    // Hard cap (AC1): the page shows at 3 s whatever happens.
    setTimeout(ready, 3000);
    // After parsing, so the font loads have started and document.fonts.ready means "fonts in".
    d.addEventListener("DOMContentLoaded", function () {
      main = d.getElementById("main");
      status = d.querySelector("[data-load-status]");
      if (done) return;
      if (main) main.setAttribute("aria-busy", "true");
      if (status) status.textContent = "Loading the page";
      new MutationObserver(check).observe(h, {
        attributes: true,
        attributeFilter: ["class", "data-scene-load"],
      });
      const fontsReady = d.fonts ? d.fonts.ready : Promise.resolve();
      fontsReady.then(
        function () {
          fontsIn = true;
          check();
          return null;
        },
        function () {
          return null;
        },
      );
    });
  })();
</script>

<style is:global>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    background: var(--bg);
    transition:
      opacity 0.24s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0s 0.24s;
    /* Failsafe: even if JS never calls ready, the cover is gone at 3.2 s. */
    animation: ld-cap 0s 3.2s forwards;
  }

  /* Without JS it never shows (and runs no animations a settled page would still report). */
  html:not(.js) .loader {
    display: none;
  }

  html.is-ready .loader {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* Drop the failsafe once JS has taken over: Gecko lets a pending opacity animation (ld-cap,
       still in its delay) block the exit transition, so the cover snapped away on removal. */
    animation: none;
  }

  /* Early ready (before the content's reveal ended): the content goes at once, only the cover fades. */
  html.is-early .loader__glow,
  html.is-early .loader__in {
    animation: none;
    opacity: 0;
  }

  @keyframes ld-cap {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  .loader__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      60vmax 45vmax at 82% 8%,
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent 70%
    );
    animation:
      ld-in 0.32s ease-out 0.3s both,
      ld-glow 2.4s ease-in-out 0.62s infinite alternate;
  }

  .loader__in {
    display: grid;
    justify-items: center;
    gap: 20px;
    animation: ld-in 0.32s ease-out 0.3s both;
  }

  /* The print's own paper and ink tones (from the intro still); no design token exists for them. */
  .loader__print {
    position: relative;
    width: clamp(128px, 14vw, 184px);
    aspect-ratio: 2048 / 1462;
    border: 3px solid #020100;
    background: #3b1f10;
    overflow: hidden;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.55);
  }

  .loader__burst,
  .loader__plate {
    position: absolute;
    opacity: 0;
    animation: ld-dev 2.2s cubic-bezier(0.3, 0, 0.2, 1) 0.4s both;
  }

  .loader__burst {
    inset: 0;
    background: repeating-conic-gradient(
      from 0deg at 74% 40%,
      #120a06 0 3.75deg,
      transparent 3.75deg 7.5deg
    );
  }

  .loader__plate {
    left: 5%;
    bottom: 6%;
    width: 68%;
    height: 40%;
    background: #3b1f10;
    animation-delay: 0.9s;
  }

  .loader__plate::before,
  .loader__plate::after {
    content: "";
    position: absolute;
    left: 8%;
    background: #120a06;
  }

  .loader__plate::before {
    top: 20%;
    width: 84%;
    height: 42%;
  }

  .loader__plate::after {
    top: 74%;
    width: 60%;
    height: 10%;
  }

  /* System mono on purpose: the cover never waits on, or shifts with, web fonts. */
  .loader__cap {
    margin: 0;
    font:
      500 11px/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.24em;
    color: var(--muted);
  }

  .loader__timer {
    width: 96px;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .loader__timer::before {
    content: "";
    display: block;
    height: 100%;
    background: var(--accent-2);
    transform-origin: left;
    transform: scaleX(0);
    animation: ld-timer 3s linear both;
  }

  @keyframes ld-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes ld-glow {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes ld-dev {
    0% {
      opacity: 0;
      filter: blur(3px);
    }
    100% {
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes ld-timer {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader {
      transition: none;
    }

    .loader__glow,
    .loader__in,
    .loader__burst,
    .loader__plate,
    .loader__timer::before {
      animation: none;
    }

    .loader__glow,
    .loader__in,
    .loader__burst,
    .loader__plate {
      opacity: 1;
    }

    .loader__timer {
      display: none;
    }
  }
</style>
