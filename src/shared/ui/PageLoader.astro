---
/**
 * PF-75 first-open loader, "Aperture iris" (design/loading-v2/final-C.md; base rules from PF-67
 * design/loading/design.md).
 *
 * A fixed cover in the page background colour, opaque from first paint (this component's CSS is
 * inlined in <head> with the rest; render it as the first child of <body>). After 300 ms a small
 * closed iris fades in over the hero still: an amber rim ring (::before) that pulses, with faint
 * blade rays (::after) outside it. There is no hole yet (the cover is solid), so the wait never
 * shows the page. Once the page is ready (web fonts in, and the first section's visual shown: the intro
 * still decoded, or the scene loader settled), or at the 2.6 s cap, the hole turns transparent
 * and opens to the whole viewport in 600 ms; then the cover is hidden and removed. Ready in under
 * 300 ms (before the iris shows): no iris at all, the cover just fades over 240 ms (is-early). A
 * CSS failsafe hides it at 3.2 s even if this script dies, and without JS it never shows. The page
 * lays out and paints normally beneath it: the cover is position: fixed and only its background, its
 * pseudo-elements and its opacity change, so nothing on the page moves. No text, no image, no web font.
 *
 * Screen readers: #main is aria-busy and a polite status says "Loading the page", then
 * "Page loaded". The cover is aria-hidden and has nothing focusable; the skip link (z-index 100)
 * stays above it.
 *
 * PF-84: lib/stage.ts swaps the intro still for the live tray at once while the cover is opaque
 * (states 0-1), never during the open (html.is-ready, cover still shown), and crossfades after.
 */
---

<div class="loader" aria-hidden="true"></div>
<p class="visually-hidden" role="status" aria-live="polite" data-load-status></p>
<script is:inline>
  (function () {
    const d = document;
    const h = d.documentElement;
    let done = false;
    let fontsIn = false;
    let main = null;
    let status = null;
    if (!h.classList.contains("js")) return;
    const ready = function () {
      if (done) return;
      done = true;
      const loader = d.querySelector(".loader");
      let early = true;
      if (loader) {
        // Early = still before the iris's 300 ms delay (its pulse not yet running): no iris, the
        // cover only fades. Later: freeze the pulse and the rays where they are, so the open
        // starts from what is on screen.
        const pulse = loader.getAnimations().find(function (a) {
          return a.animationName === "ld-pulse";
        });
        early = Boolean(pulse) && !(pulse.currentTime >= 300);
        const s = loader.style;
        const b = getComputedStyle(loader, "::before");
        const a = getComputedStyle(loader, "::after");
        const rs = parseFloat(b.width) / 2;
        // The rays' mask hole (r0 × 1.06 + 8 px), with r0 = rs / the pulse factor now.
        const m = (rs / parseFloat(getComputedStyle(loader).getPropertyValue("--k"))) * 1.06 + 8;
        s.setProperty("--rs", rs + "px");
        s.setProperty("--o", b.opacity);
        s.setProperty("--a0", a.rotate.replace("none", "0deg"));
        s.setProperty("--s0", String((rs + 8) / m));
        s.setProperty("--s1", String((parseFloat(a.width) / 2 - rs) / m));
      }
      h.classList.add(early ? "is-early" : "is-open", "is-ready");
      if (main) main.removeAttribute("aria-busy");
      if (status) status.textContent = "Page loaded";
      // Gone 100 ms after the open ends (or after the 240 ms early fade); a timer backs it up.
      if (loader) {
        const gone = function () {
          setTimeout(function () {
            loader.remove();
          }, 100);
        };
        loader.addEventListener("animationend", function (e) {
          if (e.animationName === "ld-open") gone();
        });
        setTimeout(gone, early ? 300 : 1000);
      }
    };
    // Ready = fonts in AND the first section's visual is shown: the intro still decoded
    // (html.still0-loaded) or the scene loader settled (data-scene-load). Pages without an intro
    // still (404) only wait for the fonts. This is the one place that decides it.
    const check = function () {
      if (
        fontsIn &&
        (!d.querySelector('[data-still="0"]') ||
          h.classList.contains("still0-loaded") ||
          /^(ready|failed|off)$/.test(h.dataset.sceneLoad || ""))
      )
        ready();
    };
    // Hard cap: ready at 2.6 s from navigation start whatever happens, so the 600 ms open ends by
    // the 3.2 s failsafe (which the open keeps running).
    setTimeout(ready, 2600 - performance.now());
    // After parsing, so the font loads have started and document.fonts.ready means "fonts in".
    d.addEventListener("DOMContentLoaded", function () {
      main = d.getElementById("main");
      status = d.querySelector("[data-load-status]");
      if (done) return;
      if (main) main.setAttribute("aria-busy", "true");
      if (status) status.textContent = "Loading the page";
      new MutationObserver(check).observe(h, {
        attributes: true,
        attributeFilter: ["class", "data-scene-load"],
      });
      const fontsReady = d.fonts ? d.fonts.ready : Promise.resolve();
      fontsReady.then(
        function () {
          fontsIn = true;
          check();
          return null;
        },
        function () {
          return null;
        },
      );
    });
  })();
</script>

<style is:global>
  /* The pulse (--k, radius factor) and the open (--p, 0 → 1), animatable. Numbers with literal
     keyframes: Gecko animates a registered property whose keyframes use var() discretely. Without
     @property the open is a plain cut. */
  @property --k {
    syntax: "<number>";
    inherits: true;
    initial-value: 1;
  }

  @property --p {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  /* Iris centre over the hero still's tray; --r0 wait radius, --r1 reaches the farthest corner
     (without hypot() it is invalid: no open, the cover just cuts at 600 ms). Kept cheap to
     paint (WebKit CI rasters on the CPU): the cover is solid until the open, then a gradient
     with a hole (no mask on the cover: masking it re-rendered the turning rays every frame), the
     rim is one small circle and the rays a static layer that turns on the compositor. */
  .loader {
    --cx: 68vw;
    --cy: 52vh;
    --r0: clamp(28px, 2.8vmax, 44px);
    --r1: calc(hypot(max(var(--cx), 100vw - var(--cx)), max(var(--cy), 100vh - var(--cy))) + 8px);
    --r: calc(var(--r0) * var(--k));
    --h: 0px;
    position: fixed;
    inset: 0;
    z-index: 90;
    pointer-events: none;
    background: var(--bg);
    transition:
      opacity 0.24s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0s 0.24s;
    /* Failsafe: even if JS never calls ready, the cover is gone at 3.2 s. */
    animation:
      ld-cap 0s 3.2s forwards,
      ld-pulse 1.2s ease-in-out 0.3s infinite alternate;
  }

  .loader::before,
  .loader::after {
    content: "";
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    translate: -50% -50%;
    border-radius: 50%;
  }

  /* Rim: core amber line inside r, outer accent ring, soft falloff into the cover. Pulses .55-1. */
  .loader::before {
    z-index: 1;
    width: calc(2 * var(--r));
    height: calc(2 * var(--r));
    box-shadow:
      inset 0 0 0 1.5px var(--accent-2),
      0 0 0 2px var(--accent),
      0 0 4px 2px #ff7a3d59;
    animation:
      ld-in 0.32s ease-out 0.3s both,
      ld-glow 1.2s ease-in-out 0.62s infinite alternate;
  }

  /* Six faint blades (30° on / 30° off) outside the ring; they turn 30° over 8 s. */
  .loader::after {
    width: calc(2 * var(--r1));
    height: calc(2 * var(--r1));
    --m: calc(var(--r0) * 1.06 + 8px);
    /* While waiting the middle is a disc in the cover colour (cheaper to turn than a mask). */
    background:
      radial-gradient(var(--bg) var(--m), #0000 calc(var(--m) + 1px)),
      repeating-conic-gradient(from 12deg, #ffc24b17 0 30deg, #0000 0 60deg);
    animation:
      ld-in 0.32s ease-out 0.3s both,
      ld-turn 8s linear 0.3s forwards;
  }

  /* Without JS it never shows (and runs no animations a settled page would still report). */
  html:not(.js) .loader {
    display: none;
  }

  /* Drop the failsafe once JS has taken over: Gecko lets a pending opacity animation (ld-cap,
     still in its delay) block the exit transition, so the cover snapped away on removal. */
  .is-ready .loader {
    animation: none;
  }

  /* Early ready (before the iris shows): no iris, only the cover fades. */
  .is-early .loader {
    opacity: 0;
    visibility: hidden;
  }

  .is-early .loader::before,
  .is-early .loader::after {
    animation: none;
    opacity: 0;
  }

  /* The open: the hole shows the page and grows past the corners; the rim fades at 480-600 ms;
     the rays turn 12° more. It starts from the values JS froze (--rs, --o, --a0). */
  .is-open .loader {
    --r: calc(var(--rs) + (var(--r1) - var(--rs)) * var(--p));
    --h: calc(var(--r) - 1.5px);
    background: radial-gradient(circle at var(--cx) var(--cy), #0000 var(--h), var(--bg) 0);
    animation:
      ld-cap 0s 3.2s forwards,
      ld-open 0.6s cubic-bezier(0.7, 0, 0.2, 1) forwards;
  }

  .is-open .loader::before {
    animation: ld-rim 0.6s linear forwards;
  }

  /* The rays' hole keeps up with the iris by scaling the layer (its mask stays as painted; the
     blades are scale-invariant): scale = (r + 8px) / (r0 × 1.06 + 8px), linear in --p, with the
     two factors from JS. A mask that changes every frame was too slow to raster. */
  .is-open .loader::after {
    background: repeating-conic-gradient(from 12deg, #ffc24b17 0 30deg, #0000 0 60deg);
    mask: radial-gradient(#0000 var(--m), #000 calc(var(--m) + 1px));
    scale: max(1, var(--s0) + var(--s1) * var(--p));
    animation: ld-spin 0.6s cubic-bezier(0.7, 0, 0.2, 1) forwards;
  }

  @keyframes ld-cap {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @keyframes ld-in {
    from {
      opacity: 0;
    }
  }

  @keyframes ld-glow {
    to {
      opacity: 0.55;
    }
  }

  @keyframes ld-pulse {
    to {
      --k: 1.06;
    }
  }

  @keyframes ld-turn {
    to {
      rotate: 30deg;
    }
  }

  @keyframes ld-open {
    to {
      --p: 1;
      visibility: hidden;
    }
  }

  @keyframes ld-rim {
    0%,
    80% {
      opacity: var(--o);
    }

    to {
      opacity: 0;
    }
  }

  @keyframes ld-spin {
    from {
      rotate: var(--a0);
    }

    to {
      rotate: calc(var(--a0) + 12deg);
    }
  }

  @media (max-width: 1023px) {
    .loader {
      --cx: 66vw;
      --cy: 58vh;
    }
  }

  @media (max-width: 767px) {
    .loader {
      --cx: 50vw;
      --cy: 44vh;
      --r0: 28px;
    }
  }
</style>
