{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio of Phuc Le, built with Astro, Three.js and Motion.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit -p .",
    "lint": "bun run lint:oxlint && bun run lint:fsd",
    "lint:oxlint": "oxlint",
    "lint:fsd": "steiger ./src --fail-on-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "hw:verify": "node tools/hw/verify.ts",
    "budget:check": "node tools/budget/check.ts",
    "verify": "bun run check && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build",
    "prepare": "node tools/install-git-hooks.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.4.11",
    "motion": "^14.12.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@oxlint/plugins": "1.93.0",
    "@playwright/test": "^1.65.0",
    "@steiger/toolkit": "0.2.4",
    "@types/three": "^0.187.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "steiger": "0.10.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.23.4"
  },
  "packageManager": "bun@1.4.4"
}
