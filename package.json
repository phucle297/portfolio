{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio of Phuc Le, built with Astro, Three.js and Motion.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit -p .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "bun run check && bun run typecheck && bun run lint && bun run format:check && bun run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.11",
    "motion": "^14.12.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@types/three": "^0.187.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.23.4"
  },
  "packageManager": "bun@1.4.4"
}
